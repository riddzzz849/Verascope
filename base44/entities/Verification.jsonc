
{
  "name": "Verification",
  "type": "object",
  "properties": {
    "input_text": {
      "type": "string",
      "description": "The verbatim claim or text submitted for verification"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "text",
        "url",
        "image",
        "quick"
      ],
      "description": "How the claim was submitted"
    },
    "overall_state": {
      "type": "string",
      "enum": [
        "well_supported",
        "partially_supported",
        "conflicting",
        "poorly_supported",
        "insufficient",
        "outdated"
      ],
      "description": "The overall reliability assessment state"
    },
    "overall_summary": {
      "type": "string",
      "description": "One-line plain-language summary of the assessment"
    },
    "confidence": {
      "type": "number",
      "description": "Confidence indicator 0-100"
    },
    "source_count": {
      "type": "number",
      "description": "Number of sources reviewed"
    },
    "category": {
      "type": "string",
      "description": "Primary claim category (health, government, finance, etc.)"
    },
    "report_data": {
      "type": "object",
      "description": "The full structured verification report JSON"
    }
  },
  "required": [
    "input_text",
    "input_type",
    "overall_state"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}

